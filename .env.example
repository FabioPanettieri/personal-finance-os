# -----------------------------------------------------------------------------
# Personal Finance OS — variabili d'ambiente
#
# Copia questo file in `.env.local` (già ignorato da git) e compila i valori.
# NON inserire mai chiavi reali in questo file né in altri file versionati.
#
# Dove trovare i valori (Supabase Dashboard → Project Settings → API Keys):
#   - URL del progetto:      https://<project-ref>.supabase.co
#   - Publishable key:       sb_publishable_...  (ex "anon key")
#
# Sviluppo con Supabase CLI locale (`supabase start`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key stampata da `supabase status`>
#
# Le variabili NEXT_PUBLIC_* sono incorporate nel bundle al momento della build:
# devono essere presenti quando si esegue `npm run build` (su Vercel: Project
# Settings → Environment Variables). Sono pubbliche per natura: la protezione
# dei dati è garantita da Row Level Security, non dalla segretezza della chiave.
#
# Senza queste variabili l'app parte comunque, ma nessuna pagina protetta è
# accessibile: il login mostra l'avviso "Supabase non configurato".
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Solo server / script — NON usare il prefisso NEXT_PUBLIC_.
# Non necessaria per lo Sprint 1: servirà agli script amministrativi (seed di
# sviluppo, backup). Mai su Vercel se non indispensabile.
# -----------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=
